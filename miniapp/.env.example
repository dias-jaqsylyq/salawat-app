# Public API base URL of the deployed salawat-bot backend (Railway).
# Get this from Railway → your service → Settings → Networking → Public Domain.
# Placeholder below — replace before building/deploying for real.
VITE_API_URL=https://REPLACE_WITH_RAILWAY_DOMAIN.up.railway.app

# Optional, dev only: a real initData string captured from an actual Telegram
# session (open the deployed app in Telegram once, log window.Telegram.WebApp.initData
# to the console, paste it here). Lets `npm run dev` hit the real backend end-to-end
# from a normal browser, without it your local API calls will 401 (unsigned).
# Expires ~24h after capture (see INIT_DATA_MAX_AGE_SECONDS on the backend).
# VITE_DEV_INIT_DATA=
